{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/gestao/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/du99/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/gestao/nr1/",
      "destination": "/api/painel"
    },
    {
      "source": "/evento/nr1-estrategica/certificado/c/:codigo/",
      "destination": "/api/certificado?pagina=:codigo"
    },
    {
      "source": "/mariana-uebel/aula-g4/enviar/",
      "destination": "https://grou-social.vercel.app/api/publico/mapa"
    },
    {
      "source": "/du99/api/:rota/",
      "destination": "/api/certificado?du99=:rota"
    },
    {
      "source": "/du99/c/:codigo/",
      "destination": "/api/certificado?du99=pagina&codigo=:codigo"
    },
    {
      "source": "/du99/evento/:slug/",
      "destination": "/du99/evento/"
    },
    {
      "source": "/mariana-uebel/lideranca-sob-pressao/",
      "destination": "/mariana-uebel/aula-g4/"
    }
  ],
  "functions": {
    "api/painel.js": {
      "includeFiles": "api/_painel.html"
    }
  },
  "redirects": [
    {
      "source": "/convite/:codigo/",
      "destination": "/evento/nr1-estrategica/?cupom=:codigo&utm_source=convite&utm_medium=card&utm_campaign=:codigo",
      "permanent": false
    },
    {
      "source": "/consulting/programas-de-lideranca/",
      "destination": "/consulting/",
      "permanent": true
    },
    {
      "source": "/consulting/capacitacoes-e-treinamentos/",
      "destination": "/consulting/",
      "permanent": true
    },
    {
      "source": "/credenciamento/",
      "destination": "/evento/nr1-estrategica/porta/",
      "permanent": false
    },
    {
      "source": "/salessprint/",
      "destination": "/demo-pda/?utm_source=salessprint&utm_medium=qrcode&utm_campaign=sales-sprint",
      "permanent": false
    }
  ]
}
